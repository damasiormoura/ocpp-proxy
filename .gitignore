# Dependencies
node_modules/
vendor/
.venv/

# Build output
dist/
build/
target/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
*.log

# Proptest failure seeds. Regenerated locally when a property actually fails;
# the ones this repo accumulated recorded tests that were out of step with the
# specification rather than defects in the code.
tests/*.proptest-regressions

# Deployment parameters and rendered output. Every site-specific value — the
# Charge Point ID, the Central System address, the broker address — is a
# deployment parameter, not repository content. See deploy/local.env.example.
deploy/local.env
deploy/.rendered/
