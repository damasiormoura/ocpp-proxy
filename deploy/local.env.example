# Deployment parameters for this site.
#
# Copy to  deploy/local.env  and fill in. That file is gitignored: none of these
# values belong in the repository. The Charge Point ID in particular identifies
# a specific charger to its e-mobility operator, and by extension its owner.
#
#   cp deploy/local.env.example deploy/local.env
#   $EDITOR deploy/local.env
#   ./deploy/render.sh
#
# Rendered output lands in deploy/.rendered/, also gitignored. Deploy from
# there, never from the templates.
#
# Secrets are NOT here. MQTT credentials live in /etc/ocpp-proxy/secrets.env on
# the target, mode 600 — see deploy/lxc/README.md.

# --- Identity --------------------------------------------------------------
# The Charge Point ID your operator issued. Appears in the upstream URL, every
# MQTT topic, and the Home Assistant entity IDs.
CHARGE_POINT_ID=CP-EXAMPLE-0001

# --- Central System --------------------------------------------------------
# Base URL, no trailing Charge Point ID — the proxy appends it.
CENTRAL_SYSTEM_URL=ws://10.0.0.10/ocpp/1.6

# The Central System's network, for the destination route that sends its
# traffic out of the mobile interface instead of the default gateway.
CENTRAL_SYSTEM_NETWORK=10.0.0.0/24

# --- Mobile broadband dongle ----------------------------------------------
# The LAN the USB dongle presents to the host, and the static address the host
# takes on it. No default gateway is configured from this interface — only the
# destination route above.
WWAN_NETWORK=192.168.8.0/24
WWAN_ADDRESS=192.168.8.169/24
WWAN_GATEWAY=192.168.8.1

# --- Charger-facing listener ----------------------------------------------
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=9000
HEALTH_PORT=8080

# Only needed if upstream egress must be selected by source address rather
# than by a destination route. Left unset in the reference deployment.
UPSTREAM_BIND_ADDRESS=

# --- MQTT broker -----------------------------------------------------------
MQTT_HOST=192.0.2.10
MQTT_PORT=1883

# --- Deploy targets --------------------------------------------------------
# Used by deploy/deploy.sh and the GitHub Actions deploy workflow.
#
# The Proxmox host is reached over SSH; the container is reached through it
# with `pct`, so the container needs no SSH server of its own.
PROXMOX_HOST=192.0.2.1
PROXMOX_SSH_USER=root
LXC_ID=113

# Home Assistant, for the package and dashboard. Reached through the Proxmox
# host with `qm guest exec`, so this is the VM ID, not an address.
HA_VMID=110
HA_CONFIG_DIR=/mnt/data/supervisor/homeassistant
