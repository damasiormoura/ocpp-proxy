[Unit]
Description=Policy route the OCPP proxy's Mobi.e traffic over the host's WWAN link
Before=ocpp-proxy.service
After=network-online.target
Wants=network-online.target

# Why this exists — the non-obvious half of the egress design.
#
# Binding the upstream socket to 10.80.0.2 sets the SOURCE address. It does not
# choose a ROUTE. Without the rule below, the kernel looks up the Mobi.e
# destination in the main table, matches the default route via 192.168.50.1,
# and hands the main router a packet sourced from 10.80.0.2 — an address it has
# never heard of. The connection dies, and it dies in a way that looks like
# Mobi.e being unreachable rather than a routing mistake.
#
# So the policy rule is needed in BOTH places: here, so the container sends the
# packet to the host across vmbr2; and on the host, so the host forwards it out
# wwan0 instead of back to the LAN.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip route replace default via 10.80.0.1 dev eth1 table 100
ExecStart=/bin/sh -c 'ip rule show | grep -q "from 10.80.0.2 lookup 100" || ip rule add from 10.80.0.2 lookup 100 priority 100'
ExecStop=/bin/sh -c 'ip rule del from 10.80.0.2 lookup 100 priority 100 2>/dev/null || true'
ExecStop=/bin/sh -c 'ip route flush table 100 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
