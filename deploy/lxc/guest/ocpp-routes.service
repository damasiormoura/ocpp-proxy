[Unit]
Description=Static routes the OCPP proxy needs on its two gateway-less legs
Before=ocpp-proxy.service
After=network-online.target
Wants=network-online.target

# Why this exists.
#
# The Central System is the Central System URL (see deploy/local.env) — a fixed
# RFC1918 address reachable only inside the APN. Without the route below, the
# container matches its LAN default route and sends Mobi.e traffic to the main
# router, which cannot reach @CENTRAL_SYSTEM_NETWORK@. The symptom is "Mobi.e
# unreachable", which reads as an upstream fault rather than a routing mistake.
#
# The route is needed in BOTH places: here, so the container hands the packet
# to the host across vmbr2, and on the host, so the host forwards it out wwan0
# instead of back to the LAN.
#
# A destination route rather than a source-address policy rule, because the
# endpoint is a fixed private range. That keeps the app out of it entirely —
# no bind-address configuration, and nothing to keep in sync between the two
# halves except one prefix.
#
# The second route is the charger's return path, and it is easy to miss
# because the charger dials in rather than being dialled. Inbound works
# without it — the spare router already routes 192.168.52.0/24 here — but the
# proxy's replies would leave via its LAN default route to 192.168.50.1, which
# knows nothing of 192.168.51.0/24. The connection would half-open and fail
# asymmetrically. Home Assistant and Frigate get this route from the host's
# dnsmasq via DHCP option 121; this container has a static address, so it does
# not, and must be told explicitly.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ocpp-routes.sh
ExecStop=/bin/sh -c 'ip route del @CENTRAL_SYSTEM_NETWORK@ 2>/dev/null || true'
ExecStop=/bin/sh -c 'ip route del 192.168.51.0/24 2>/dev/null || true'

# The script already waits for each next hop, but a container that comes back
# with networking genuinely broken should keep trying rather than give up
# after one attempt at boot.
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
