# ==============================================================================
# OCPP Proxy Configuration
# ==============================================================================
#
# This file documents all configuration parameters for the OCPP Proxy.
#
# Configuration layering (highest precedence first):
#   1. Environment variables with prefix OCPP_PROXY_ (use __ for nesting)
#   2. YAML file at CONFIG_FILE_PATH env var, or ./config.yaml if not set
#
# Environment variable examples:
#   OCPP_PROXY_CENTRAL_SYSTEM_URL=wss://mobi-e.example.com/ocpp/v16
#   OCPP_PROXY_LISTEN_PORT=9000
#   OCPP_PROXY_HEALTH_PORT=8080
#   OCPP_PROXY_MQTT__HOST=mqtt.example.com
#   OCPP_PROXY_MQTT__PORT=8883
#   OCPP_PROXY_MQTT__USERNAME=ocpp_proxy
#   OCPP_PROXY_MQTT__PASSWORD=secret
#   OCPP_PROXY_MQTT__CA_CERT_PATH=/certs/ca.pem
#   OCPP_PROXY_MQTT__CLIENT_CERT_PATH=/certs/client.pem
#   OCPP_PROXY_MQTT__CLIENT_KEY_PATH=/certs/client-key.pem
#   OCPP_PROXY_LOGGING__LEVEL=INFO
#   OCPP_PROXY_BUFFERS__MESSAGE_BUFFER_SIZE=100
#   OCPP_PROXY_BUFFERS__MQTT_BUFFER_SIZE=500
#   OCPP_PROXY_BUFFERS__MAX_BACKOFF_SECONDS=60
#
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: Central System (Mobi.e) WebSocket URL
# ------------------------------------------------------------------------------
# The WebSocket URL of the OCPP 1.6J Central System.
# Must use ws:// or wss:// scheme.
# The Charge Point ID from the charger connection will be appended to this path.
central_system_url: "wss://mobi-e.example.com/ocpp/v16"

# ------------------------------------------------------------------------------
# REQUIRED: WebSocket Listen Port
# ------------------------------------------------------------------------------
# Port on which the proxy listens for incoming charger WebSocket connections.
# Valid range: 1-65535
listen_port: 9000

# ------------------------------------------------------------------------------
# OPTIONAL: Charger-facing bind address (default: 0.0.0.0)
# ------------------------------------------------------------------------------
# Set to the LXC's LAN address so the listener is not exposed on the
# WWAN-egress interface.
# listen_address: "192.168.50.28"

# ------------------------------------------------------------------------------
# OPTIONAL: Upstream source address
# ------------------------------------------------------------------------------
# Local source address for the Central System connection. Host policy routing
# keys on this address to send Mobi.e traffic over the 4G APN rather than the
# LAN default route. Omit for development against a directly reachable server.
# upstream_bind_address: "10.80.0.2"

# ------------------------------------------------------------------------------
# OPTIONAL: Health Check Port (default: 8080)
# ------------------------------------------------------------------------------
# Port for the HTTP health check endpoint (/health).
# Used by AWS ECS/NLB health checks and monitoring tools.
# Valid range: 1-65535
health_port: 8080

# ------------------------------------------------------------------------------
# REQUIRED: MQTT Broker Configuration
# ------------------------------------------------------------------------------
mqtt:
  # Hostname or IP of the MQTT broker
  host: "mqtt.example.com"

  # MQTT broker port (typically 8883 for MQTTS)
  # Valid range: 1-65535
  port: 8883

  # MQTT authentication credentials
  # In production, use AWS Secrets Manager or environment variables instead
  username: "ocpp_proxy"
  password: "your-secure-password-here"

  # TLS certificate paths for secure MQTT connection
  # All three are required for mutual TLS authentication
  # OPTIONAL. The broker is one LAN hop away (EMQX on the Home Assistant
  # VM), not across the internet, so TLS is not required.
  #   all three omitted  -> plaintext, username/password only
  #   ca_cert_path only  -> server-authenticated TLS
  #   all three set      -> mutual TLS
  # ca_cert_path: "/certs/mqtt/ca.pem"
  # client_cert_path: "/certs/mqtt/client.pem"
  # client_key_path: "/certs/mqtt/client-key.pem"

# ------------------------------------------------------------------------------
# OPTIONAL: Logging Configuration
# ------------------------------------------------------------------------------
logging:
  # Log level: DEBUG, INFO, WARNING, or ERROR
  # Default: INFO
  # Logs are output as structured JSON to stdout
  level: "INFO"

# ------------------------------------------------------------------------------
# OPTIONAL: Buffer and Backoff Configuration
# ------------------------------------------------------------------------------
buffers:
  # Maximum number of OCPP messages buffered when upstream/downstream is
  # disconnected. Oldest messages are discarded (FIFO) when the limit is reached.
  # Default: 100
  message_buffer_size: 100

  # Maximum number of MQTT messages buffered when the MQTT broker is unreachable.
  # Oldest messages are discarded (FIFO) when the limit is reached.
  # Default: 500
  mqtt_buffer_size: 500

  # Maximum reconnection backoff interval in seconds for WebSocket connections.
  # Exponential backoff starts at 2s and doubles until this maximum.
  # Default: 60
  max_backoff_seconds: 60

# ------------------------------------------------------------------------------
# OPTIONAL: Charger control — the proxy's own OCPP commands
# ------------------------------------------------------------------------------
# Everything above is transparent forwarding. This section is the one place
# the proxy speaks OCPP itself: on a request published to
#   ocpp/{charge_point_id}/command                (JSON, see README)
#   ocpp/{charge_point_id}/command/current_limit  (a bare number of amps, or "clear")
# it sends a SetChargingProfile (or one of a few companion Calls) to the
# CHARGER, consumes the charger's answer, and publishes the outcome on
#   ocpp/{charge_point_id}/command/result
# The Central System never sees any of it. Nothing is ever sent upstream.
#
# Off by default. Off, the proxy does not even subscribe to the command topics.
charging:
  enabled: false

  # Ceiling on any limit the proxy will send. Requests above it are clamped
  # and the result says so. Put it UNDER the site's contracted current, so a
  # controller bug cannot ask the charger for more than the mains can give.
  # A 6.9 kVA single-phase contract is 30 A in total, house included.
  max_limit_a: 32

  # An EV will not charge below 6 A (IEC 61851). A request below this is sent
  # as 0 A, which pauses charging (SuspendedEVSE) with the transaction open.
  min_limit_a: 6

  # How the limit is installed on the charger.
  #   connector_id 0  — the whole charge point (all connectors)
  #   purpose         — TxDefaultProfile (widest support; applies to every
  #                     transaction, yields to a TxProfile the Central System
  #                     may install) or ChargePointMaxProfile (a true site
  #                     limit, always wins; some chargers reject it — check
  #                     SupportedFeatureProfiles with get_configuration first)
  #   profile_kind    — Absolute (startSchedule = now; unambiguous) or Relative
  #   rate_unit       — A, or W if ChargingScheduleAllowedChargingRateUnit is
  #                     Power only (converted with nominal_voltage_v × phases)
  #   number_phases   — 1 for a single-phase charger; null omits the field
  connector_id: 0
  profile_id: 1001
  stack_level: 0
  purpose: TxDefaultProfile
  profile_kind: Absolute
  rate_unit: A
  number_phases: 1
  nominal_voltage_v: 230

  # A command that has not been sent, or not been answered, within this many
  # seconds is reported as timed out.
  command_timeout_seconds: 30

  # When the charger (re)connects, re-send the last accepted limit. A charger
  # that rebooted may have forgotten its profiles; silence would mean full
  # current.
  reapply_on_connect: true

  # Keys change_configuration may touch. Nothing that alters how the charger
  # reaches or authorises with the Central System belongs here.
  allowed_configuration_keys:
    - MeterValueSampleInterval
    - MeterValuesSampledData
    - ClockAlignedDataInterval
    - MeterValuesAlignedData
    - StopTxnSampledData
    - StopTxnAlignedData
